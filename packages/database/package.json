{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "packageManager": "npm@11.3.0",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "db:generate": "dotenv -e ../../.env -- tsx ../../node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "dotenv -e ../../.env -- tsx ../../node_modules/drizzle-kit/bin.cjs push",
    "db:migrate": "dotenv -e ../../.env -- tsx ../../node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "dotenv -e ../../.env -- tsx ../../node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "db:reset": "dotenv -e ../../.env -- tsx ../../node_modules/drizzle-kit/bin.cjs drop",
    "check-types": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@kinde-oss/kinde-typescript-sdk": "^2.13.1",
    "@neondatabase/serverless": "^1.0.2",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.1",
    "hono": "^4.11.9",
    "pg": "^8.18.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "drizzle-orm": "0.45.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.21.0",
    "dotenv": "^17.2.4",
    "dotenv-cli": "^11.0.0",
    "@repo/typescript-config": "*",
    "typescript": "^5.0.0"
  },
  "type": "module"
}
