# syntax=docker/dockerfile:1
# Generic multi-stage production Dockerfile for the Hono microservices in
# services/*. Build with (from the repo root, so the whole workspace is in
# the build context):
#
#   docker build -f services/Dockerfile.service \
#     --build-arg SERVICE=@repo/cart \
#     --build-arg SERVICE_DIR=cart-service \
#     --build-arg SERVICE_PORT=4001 \
#     -t suit-masters/cart-service .
#
# SERVICE is the workspace package name (turbo/npm filter target).
# SERVICE_DIR is that package's folder name under services/.

FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN npm install -g turbo@^2

# --- Prune the monorepo down to only what this service needs -------------
FROM base AS pruner
ARG SERVICE
COPY . .
RUN turbo prune "${SERVICE}" --docker

# --- Install dependencies and build -----------------------------------
# Kept as its own stage (rather than folded into `installer`) so the
# database migration runner can target it directly with devDependencies
# (drizzle-kit) still present — see docker-compose.yml's `migrate` service.
FROM base AS builder
ARG SERVICE
# Installing from the pruned lockfile/package.json set first lets Docker
# cache this (slow) layer whenever only application code changes.
COPY --from=pruner /app/out/json/ .
RUN npm ci
COPY --from=pruner /app/out/full/ .
RUN turbo run build --filter="${SERVICE}"

# --- Trim to production-only dependencies ---------------------------------
FROM builder AS installer
# Drop devDependencies now that the build output exists; keeps the layer
# that gets copied into the runtime image as small as possible.
RUN npm prune --omit=dev

# --- Minimal runtime image -----------------------------------------------
FROM node:22-alpine AS runner
RUN apk add --no-cache dumb-init
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 hono && adduser --system --uid 1001 hono

COPY --from=installer --chown=hono:hono /app .

ARG SERVICE_DIR
ARG SERVICE_PORT=4000
ENV SERVICE_DIR=${SERVICE_DIR}
ENV PORT=${SERVICE_PORT}
EXPOSE ${SERVICE_PORT}

USER hono

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:'+process.env.PORT+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["dumb-init", "--"]
CMD ["sh", "-c", "exec node services/${SERVICE_DIR}/dist/index.js"]
