# syntax=docker/dockerfile:1
# Generic multi-stage production Dockerfile for the Next.js apps in apps/*
# (storefront + admin dashboard). Build with (from the repo root, so the
# whole workspace is in the build context):
#
#   docker build -f apps/Dockerfile.next \
#     --build-arg APP=frontend \
#     --build-arg APP_DIR=apps/frontend \
#     --build-arg NEXT_DIST_DIR=dist \
#     --build-arg APP_PORT=3000 \
#     --build-arg NEXT_PUBLIC_PRODUCT_SERVICE_URL=https://products.example.com \
#     --build-arg NEXT_PUBLIC_CART_SERVICE_URL=https://cart.example.com \
#     --build-arg NEXT_PUBLIC_ORDER_SERVICE_URL=https://orders.example.com \
#     --build-arg NEXT_PUBLIC_PAYMENT_SERVICE_URL=https://payments.example.com \
#     --build-arg NEXT_PUBLIC_AUTH_URL=https://suitmasters.example.com \
#     --build-arg NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx \
#     -t suit-masters/frontend .
#
# APP is the turbo/npm filter target ("frontend" or "admin").
# APP_DIR is that app's folder under apps/.
# NEXT_DIST_DIR must match the app's own next.config.ts distDir override
# ("dist" for the storefront, ".next" for admin) so the standalone output
# is copied from the right place.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so
# they must be supplied as --build-arg, not just as a runtime -e/environment
# entry — a runtime-only value would never reach the browser bundle.

FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN npm install -g turbo@^2

# --- Prune the monorepo down to only what this app needs -----------------
FROM base AS pruner
ARG APP
COPY . .
RUN turbo prune "${APP}" --docker

# --- Install dependencies and build ---------------------------------------
FROM base AS installer
ARG APP
ARG APP_DIR
ARG NEXT_DIST_DIR=.next

# Installing from the pruned lockfile/package.json set first lets Docker
# cache this (slow) layer whenever only application code changes.
COPY --from=pruner /app/out/json/ .
RUN npm ci
COPY --from=pruner /app/out/full/ .

# Build-time only config. DATABASE_URL / BETTER_AUTH_SECRET are only needed
# so that `@repo/auth` (imported by middleware/server routes) doesn't throw
# while Next.js statically analyzes routes — no DB connection is actually
# made during the build. Real secrets are injected at container runtime.
ARG DATABASE_URL=postgres://build:build@localhost:5432/build
ARG BETTER_AUTH_SECRET=build-time-placeholder-secret-00000000000000
ARG BETTER_AUTH_URL=http://localhost:3000
ARG NEXT_PUBLIC_AUTH_URL=http://localhost:3000
ARG BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3002
ARG NEXT_PUBLIC_PRODUCT_SERVICE_URL
ARG NEXT_PUBLIC_CART_SERVICE_URL
ARG NEXT_PUBLIC_ORDER_SERVICE_URL
ARG NEXT_PUBLIC_PAYMENT_SERVICE_URL
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
# Sentry is optional — an empty DSN just means the SDK no-ops at runtime.
ARG NEXT_PUBLIC_SENTRY_DSN
ARG SENTRY_ORG
ARG SENTRY_PROJECT
ARG SENTRY_AUTH_TOKEN
ENV DATABASE_URL=${DATABASE_URL} \
    BETTER_AUTH_SECRET=${BETTER_AUTH_SECRET} \
    BETTER_AUTH_URL=${BETTER_AUTH_URL} \
    NEXT_PUBLIC_AUTH_URL=${NEXT_PUBLIC_AUTH_URL} \
    BETTER_AUTH_TRUSTED_ORIGINS=${BETTER_AUTH_TRUSTED_ORIGINS} \
    NEXT_PUBLIC_PRODUCT_SERVICE_URL=${NEXT_PUBLIC_PRODUCT_SERVICE_URL} \
    NEXT_PUBLIC_CART_SERVICE_URL=${NEXT_PUBLIC_CART_SERVICE_URL} \
    NEXT_PUBLIC_ORDER_SERVICE_URL=${NEXT_PUBLIC_ORDER_SERVICE_URL} \
    NEXT_PUBLIC_PAYMENT_SERVICE_URL=${NEXT_PUBLIC_PAYMENT_SERVICE_URL} \
    NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=${NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY} \
    NEXT_PUBLIC_SENTRY_DSN=${NEXT_PUBLIC_SENTRY_DSN} \
    SENTRY_ORG=${SENTRY_ORG} \
    SENTRY_PROJECT=${SENTRY_PROJECT} \
    SENTRY_AUTH_TOKEN=${SENTRY_AUTH_TOKEN} \
    NEXT_TELEMETRY_DISABLED=1

RUN turbo run build --filter="${APP}"

# --- Minimal runtime image -------------------------------------------------
FROM node:22-alpine AS runner
WORKDIR /app
RUN addgroup --system --gid 1001 nextjs && adduser --system --uid 1001 nextjs

ARG APP_DIR
ARG NEXT_DIST_DIR=.next
ARG APP_PORT=3000
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=${APP_PORT} \
    HOSTNAME=0.0.0.0

# Standalone output mirrors the monorepo path, e.g.
# <dist>/standalone/apps/frontend/server.js plus a trimmed node_modules.
COPY --from=installer --chown=nextjs:nextjs /app/${APP_DIR}/${NEXT_DIST_DIR}/standalone ./
# Static assets and public/ are intentionally excluded from standalone output
# and must be copied in separately.
COPY --from=installer --chown=nextjs:nextjs /app/${APP_DIR}/${NEXT_DIST_DIR}/static ./${APP_DIR}/${NEXT_DIST_DIR}/static
COPY --from=installer --chown=nextjs:nextjs /app/${APP_DIR}/public ./${APP_DIR}/public

EXPOSE ${APP_PORT}
USER nextjs

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:'+process.env.PORT+'/').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"

ENV APP_DIR=${APP_DIR}
CMD ["sh", "-c", "exec node ${APP_DIR}/server.js"]
