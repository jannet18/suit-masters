# Copy to .env for local development / docker-compose, and set the real
# values as secrets in your CI/CD and hosting provider for production.

# ─── Database ────────────────────────────────────────────────────────────
# docker-compose's local Postgres container (see docker-compose.yml).
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/suitmasters
# The in-cluster Postgres container has no TLS listener. Set to "false" for
# docker-compose/local Postgres; omit (or leave unset) for managed providers
# like Neon/Supabase/RDS, which require TLS.
DATABASE_SSL=false
DB_POOL_MAX=10

# ─── Auth (Better Auth) ──────────────────────────────────────────────────
# Shared by apps/frontend, apps/admin, and every service via @repo/auth.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the storefront (apps/frontend) — Better Auth's own baseURL.
BETTER_AUTH_URL=http://localhost:3000
# Must match BETTER_AUTH_URL; also sent to the browser as NEXT_PUBLIC_*.
NEXT_PUBLIC_AUTH_URL=http://localhost:3000
# Comma-separated list of origins allowed to call the auth API (storefront +
# admin dashboard).
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3002

# ─── Cross-service CORS ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# ─── Service URLs (consumed by apps/frontend and apps/admin) ─────────────
# Server-side (Next.js API routes proxying to the services).
PRODUCT_SERVICE_URL=http://product-service:4000
CART_SERVICE_URL=http://cart-service:4001
PAYMENT_SERVICE_URL=http://payment-service:4002
ORDER_SERVICE_URL=http://order-service:4003
# Browser-side (must be externally reachable, not Docker-internal hostnames).
NEXT_PUBLIC_PRODUCT_SERVICE_URL=http://localhost:4000
NEXT_PUBLIC_CART_SERVICE_URL=http://localhost:4001
NEXT_PUBLIC_PAYMENT_SERVICE_URL=http://localhost:4002
NEXT_PUBLIC_ORDER_SERVICE_URL=http://localhost:4003

# ─── Stripe ───────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Optional: point the Stripe SDK at a local mock (e.g. stripe/stripe-mock in
# CI) instead of api.stripe.com. Leave unset in production.
# STRIPE_API_HOST=stripe-mock
# STRIPE_API_PORT=12111
# STRIPE_API_PROTOCOL=http

# ─── Observability ───────────────────────────────────────────────────────
# Structured logging (pino). "info" in production, "debug" locally if needed.
LOG_LEVEL=info
# Sentry is entirely optional: every SDK no-ops until SENTRY_DSN /
# NEXT_PUBLIC_SENTRY_DSN is set, so these can stay blank until you create a
# Sentry project. Server-side (services + Next.js server/edge runtimes):
SENTRY_DSN=
# Client-side (inlined into the browser bundle at build time):
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Only needed to upload source maps during `next build` (apps/*).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Misc ────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx
# Minutes before an unconfirmed stock reservation is released (default 30).
RESERVATION_TTL_MINUTES=30
NODE_ENV=production
