{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "pipeline": {
      "db:generate": {
        "cache": false
      },
      "db:push": {
        "cache": false,
        "dependsOn": ["db:generate"]
      },
      "dev": {
        "cache": false,
        "persistent": true
      }
    }
  }
}
